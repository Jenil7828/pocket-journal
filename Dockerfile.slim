FROM python:3.11-slim

# Basic environment
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    MODEL_SOURCE=local \
    MODEL_CACHE_DIR=/tmp/models

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    curl \
    openssl \
    libssl-dev \
    ca-certificates \
    dos2unix \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Packaging tools
RUN python -m pip install --upgrade \
    pip \
    setuptools \
    wheel

# CPU ML stack
RUN pip install --no-cache-dir \
    torch==2.5.1 \
    transformers==4.48.3 \
    sentence-transformers==5.1.0 \
    accelerate>=1.3.0 \
    numpy>=2.1.0 \
    safetensors>=0.4.5 \
    huggingface-hub>=0.28.0 \
    protobuf==5.28.3

# Slim application requirements
COPY Backend/requirements.slim.txt .
RUN pip install --no-cache-dir -r requirements.slim.txt

# Application code
COPY Backend /app

# Model cache
RUN mkdir -p /tmp/models

# Entrypoint
COPY Backend/scripts/entrypoint.sh /app/scripts/entrypoint.sh

RUN dos2unix /app/scripts/entrypoint.sh && \
    chmod +x /app/scripts/entrypoint.sh

# Debug info
RUN python -c "import ssl; print('OpenSSL:', ssl.OPENSSL_VERSION)"

EXPOSE 8080

ENTRYPOINT ["/app/scripts/entrypoint.sh"]